# SPAN Industrial Solutions Pvt Ltd - Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spandb

# ---------------------------------------------------------------------------
# Resend Email Notification Integration
# ---------------------------------------------------------------------------
# 1. Sign up / log in at https://resend.com
# 2. Generate an API Key under API Keys -> Create API Key
# 3. Paste your key below (starts with "re_")
RESEND_API_KEY=

# For testing with free accounts without domain verification:
# RESEND_FROM_EMAIL=SPAN Industrial Solutions <onboarding@resend.dev>
# For production with your verified company domain (recommended):
# RESEND_FROM_EMAIL=SPAN Industrial Solutions <inquiries@yourdomain.com>
RESEND_FROM_EMAIL=SPAN Industrial Solutions <onboarding@resend.dev>

# Destination corporate inbox to receive all form inquiries
RESEND_TO_EMAIL=infospan.ukd@gmail.com
