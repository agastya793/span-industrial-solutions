{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "span-industrial-api",
	"main": "server/src/worker.ts",
	"compatibility_date": "2026-10-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"NODE_ENV": "production",
		"CORS_ORIGIN": "https://spanindustrialsolutions.com,https://www.spanindustrialsolutions.com",
		"RESEND_TO_EMAIL": "INFOSPAN.UKD@gmail.com",
		"RESEND_FROM_EMAIL": "notifications@spanindustrialsolutions.com"
	},
	"ratelimits": [
		{
			"name": "INQUIRY_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "span_industrial_d1",
			"database_name": "span-industrial-d1",
			"database_id": "6587abf9-8719-4af0-95f1-7194da2d6459",
			"migrations_dir": "server/migrations/d1"
		}
	]
}